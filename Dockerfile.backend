# ==============================================================================
# Multi-User Linux Cloud Desktop - Backend Containerfile
# Alpine-based Node.js 20 LTS with Docker CLI Client
# ==============================================================================

FROM node:20-alpine

# Install Docker CLI client (only client, to communicate with mounted host socket)
RUN apk add --no-cache docker-cli netcat-openbsd

WORKDIR /app

# Copy server package manifests
COPY server/package.json ./server/

# Install server dependencies
WORKDIR /app/server
RUN npm install --omit=dev

# Copy application source code
WORKDIR /app
COPY . .

# Set working directory to server
WORKDIR /app/server

ENV PORT=3000
ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "server.js"]
