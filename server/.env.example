# ==============================================================================
# Multi-User Linux Cloud Desktop - Environment Configuration
# ==============================================================================

# Node.js Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# JWT Authentication Secret (MUST be random 64+ char string in production)
JWT_SECRET=change_this_to_a_secure_random_64_character_hex_secret_key_in_production
JWT_EXPIRES_IN=8h

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cloudos_db
DB_USER=cloudos_admin
DB_PASSWORD=replace_with_strong_database_password_12345!
DB_SSL=false

# Apache Guacamole Daemon (guacd) Integration
GUACD_HOST=guacd
GUACD_PORT=4822

# Free Server Resource Ceiling & Capacity Configuration
# (Calculated for 4 OCPU / 24 GB RAM free ARM64 cloud instance)
MAX_CONCURRENT_SESSIONS=8
CONTAINER_RAM_LIMIT_MB=2048
CONTAINER_CPU_QUOTA=1.5
CONTAINER_PIDS_LIMIT=256
IDLE_TIMEOUT_MINUTES=15
SESSION_MAX_DURATION_HOURS=2

# Persistent User Storage Path on Host
USER_DATA_PATH=/data/users
SHARED_LABS_PATH=/data/shared/labs

# Docker Networking
DOCKER_USER_NETWORK=cloudos_user_net
